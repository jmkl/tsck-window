size_factor = [0.5,0.75,1.0,0.25]
workspaces = [
    " ",
    " ",
    " ",
    " "
]


blacklist = [
    "tsck",
    "TextInputHost",
    "msedgewebview2",
    "Microsoft.CmdPal.UI",
    "StartMenuExperienceHost",
    "SearchHost"
]

hotkeys = {
    M-S-pagedown      : Func::CycleWorkspace(Prev),
    M-S-pageup        : Func::CycleWorkspace(Next),
    M-C-S-pagedown    : Func::MoveAppToWorkspace(Prev),
    M-C-S-pageup      : Func::MoveAppToWorkspace(Next),
    M-S-p             : Func::Debug,
    M-backslash       : Func::Debug,
    M-enter           : Func::SwitchMonitor,
    M-t               : Func::ToggleFloating,
    M-f               : Func::CycleSizeFactor,
    M-del             : Func::SwapFocus,
    M-up              : Hybrid(SwapFocus,           SwapFocus                 ),
    M-down            : Hybrid(SwapFocus,           SwapFocus                 ),
    M-left            : Hybrid(CycleFocusApp(Prev), CycleFloatingApp(Prev)    ),
    M-right           : Hybrid(CycleFocusApp(Next), CycleFloatingApp(Prev)    ),
    M-C-up            : Hybrid(Null,                Null                      ),
    M-C-down          : Hybrid(Null,                Null                      ),
    M-C-left          : Hybrid(Null,                Null                      ),
    M-C-right         : Hybrid(Null,                Null                      ),
    M-S-up            : Hybrid(Null,                TransformFloatingY(-50)   ),
    M-S-down          : Hybrid(Null,                TransformFloatingY(50)    ),
    M-S-left          : Hybrid(MoveApp(Prev),       TransformFloatingX(-50)   ),
    M-S-right         : Hybrid(MoveApp(Next),       TransformFloatingX(50)    ),
    M-S-C-up          : Hybrid(Null,                ResizeFloatingH(-50)      ),
    M-S-C-down        : Hybrid(Null,                ResizeFloatingH(50)       ),
    M-S-C-left        : Hybrid(Null,                ResizeFloatingW(-50)      ),
    M-S-C-right       : Hybrid(Null,                ResizeFloatingW(50)       ),
}