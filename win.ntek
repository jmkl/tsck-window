size_factor = [0.5,0.75,1.0,0.25]
workspaces = [
    " ",
    " ",
    " ",
    " "
]


blacklist = [
    "wezterm-gui",
    "tsck",
    "TextInputHost",
    "msedgewebview2",
    "Microsoft.CmdPal.UI",
    "StartMenuExperienceHost",
    "SearchHost"
]

hotkeys = {
    M-A-pagedown      : Func::CycleWorkspace(Prev),
    M-A-pageup        : Func::CycleWorkspace(Next),
    M-S-pagedown      : Func::CycleApp(Prev),
    M-S-pageup        : Func::CycleApp(Next),
    M-C-S-pagedown    : Func::MoveAppToWorkspace(Prev),
    M-C-S-pageup      : Func::MoveAppToWorkspace(Next),
    M-S-p             : Func::Debug,
    M-backslash       : Func::Debug,
    M-enter           : Func::SwitchMonitor,
    M-t               : Func::ToggleFloating,
    M-f               : Func::CycleSizeFactor,
    M-S-left          : Func::MoveApp(Prev),
    M-S-right         : Func::MoveApp(Next),
    M-left            : Func::FocusApp(Prev),
    M-right           : Func::FocusApp(Next),
    M-S-C-up          : Func::TransformFloatingY(-50),
    M-S-C-down        : Func::TransformFloatingY(50),
    M-S-C-left        : Func::TransformFloatingX(-50),
    M-S-C-right       : Func::TransformFloatingX(50),
    M-C-up            : Func::ResizeFloatingW(-50),
    M-C-down          : Func::ResizeFloatingH(50),
    M-C-left          : Func::TransformFloatingX(-50),
    M-C-right         : Func::TransformFloatingY(50),
}
