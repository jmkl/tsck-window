size_factor = [1.0, 0.75, 0.666666, 0.5, 0.333333, 0.25]
workspaces = [
    "Graphic",
    "Porn",
    "InterWeb",
    "Text Editor"
]


blacklist = [
    "tsck",
    "TextInputHost",
    "msedgewebview2",
    "Microsoft.CmdPal.UI",
    "StartMenuExperienceHost",
    "SearchHost"
]

hotkeys = {
    M-pagedown        : Func::CycleWorkspace(Prev),
    M-pageup          : Func::CycleWorkspace(Next),
    M-S-pagedown      : Func::CycleApp(Prev),
    M-S-pageup        : Func::CycleApp(Next),
    M-C-S-pagedown    : Func::MoveAppToWorkspace(Prev),
    M-C-S-pageup      : Func::MoveAppToWorkspace(Next),
    M-S-p             : Func::Debug,
    M-S-t             : Func::ToggleFloating,
    M-S-f             : Func::CycleSizeFactor,
    M-S-left          : Func::MoveApp(Prev),
    M-S-right         : Func::MoveApp(Next),
    M-left            : Func::FocusApp(Prev),
    M-right           : Func::FocusApp(Next),
    M-S-C-up            : Func::TransformY(-50),
    M-S-C-down          : Func::TransformY(50),
    M-S-C-left          : Func::TransformX(-50),
    M-S-C-right         : Func::TransformX(50),
    M-C-up          : Func::ResizeHeight(-50),
    M-C-down        : Func::ResizeHeight(50),
    M-C-left        : Func::ResizeWidth(-50),
    M-C-right       : Func::ResizeWidth(50),
}
# M-S-down       = workspace::MoveActiveWindow('down')
# M-S-left       = workspace::MoveActiveWindow('left')
# M-S-C-up       = workspace::ResizeActiveWindow(('dec','height'))
# M-S-C-down     = workspace::ResizeActiveWindow(('inc','height'))
# M-S-C-left     = workspace::ResizeActiveWindow(('dec','width'))
# M-S-C-right    = workspace::ResizeActiveWindow(('inc','width'))
